# ============================================================
#  Shopify -> WhatsApp (Meta Cloud API) bridge - env template
#  Copy to ".env" and fill in real values.
# ============================================================

# --- Server ---
PORT=3000

# --- Shopify store ---
# Your *.myshopify.com domain
SHOP_DOMAIN=your-store.myshopify.com
# App client id + secret (Partner/dev app). The secret is also the
# HMAC key for the Shopify order webhook.
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
# Optional STATIC Admin API token (shpat_... from a store custom app
# OR an OAuth offline token) with read_orders + read_products. When
# set it overrides the client-credentials grant for all Admin calls.
SHOPIFY_ADMIN_TOKEN=

# --- Message provider ---
# "meta" = send directly via Meta WhatsApp Cloud API (recommended).
# "joud" = legacy joud.chat path.
MESSAGE_PROVIDER=meta

# --- Meta WhatsApp Cloud API ---
META_ACCESS_TOKEN=your_meta_access_token
META_WABA_ID=your_whatsapp_business_account_id
META_PHONE_NUMBER_ID=your_phone_number_id
META_API_VERSION=v22.0
# Sent template (IMAGE header + body params). Language is auto-read
# from the live template; this is only a fallback.
META_TEMPLATE_NAME=order_confirm_iamge
META_ORDER_UPDATE_TEMPLATE_NAME=order_update
# URL button index for order_update. Keep 0 unless the tracking
# button is not the first button in the Meta template.
META_ORDER_UPDATE_BUTTON_INDEX=0
META_TEMPLATE_LANG=en
# Optional fallback header image URL when a product has none.
META_FALLBACK_IMAGE=
# Verify token for the inbound WhatsApp webhook (any string; enter
# the same value in Meta App -> WhatsApp -> Configuration).
META_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret -> verifies X-Hub-Signature-256 on the inbound
# webhook. REQUIRED before exposing the server publicly.
META_APP_SECRET=

# --- Admin API protection ---
# When set, mutating/admin API routes require this value in the
# `x-admin-token` header. Leave empty for local dev only.
ADMIN_UI_TOKEN=

# --- joud.chat (legacy; only used when MESSAGE_PROVIDER=joud) ---
JOUD_API_TOKEN=
JOUD_BASE_URL=https://joud.chat/api/v1
JOUD_PHONE_NUMBER_ID=1115965254927153

# --- Phone normalization ---
# Country code applied (without +) when a local number is detected.
# 20 = Egypt.
DEFAULT_COUNTRY_CODE=20

# --- Fulfilled-order tracking updates ---
# Poll Shopify for fulfilled orders and send META_ORDER_UPDATE_TEMPLATE_NAME.
# Railway runs this in the web process; successful message_log rows make it
# idempotent so each order receives order_update once.
ORDER_UPDATE_CRON_ENABLED=true
ORDER_UPDATE_CRON_INTERVAL_MS=60000
ORDER_UPDATE_CRON_BATCH_LIMIT=50

# --- Supabase ---
# From your Supabase project -> Settings -> API.
# Leave empty to run in degraded (in-memory) mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
